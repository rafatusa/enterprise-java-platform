{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/app/logs/application.log",
            "log_group_name": "/<%= @project %>/application",
            "log_stream_name": "{instance_id}/application",
            "timezone": "UTC",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/<%= @project %>/nginx",
            "log_stream_name": "{instance_id}/access",
            "timezone": "UTC",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/<%= @project %>/nginx",
            "log_stream_name": "{instance_id}/error",
            "timezone": "UTC",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/postgresql/postgresql-*-main.log",
            "log_group_name": "/<%= @project %>/postgresql",
            "log_stream_name": "{instance_id}/postgresql",
            "timezone": "UTC",
            "retention_in_days": -1
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "<%= @project %>",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"],
        "metrics_collection_interval": 60
      }
    }
  }
}
