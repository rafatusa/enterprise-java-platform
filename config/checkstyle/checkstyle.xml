<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle configuration for enterprise-java-platform.

  SCOPE: this ruleset enforces things that cause real defects or real review
  friction — naming, unused/star imports, brace correctness, equals/hashCode,
  switch defaults. It deliberately does NOT enforce Javadoc on every member or
  whitespace minutiae: Spotless with google-java-format already owns formatting,
  and two tools arguing about the same lines produces noise, not quality.

  severity=warning combined with violationSeverity=warning in the POM means ANY
  finding fails the build — that is the requested "Checkstyle violations exist"
  gate. Because the gate is absolute, the rule SET must be one where every
  finding is genuinely worth stopping a release for.
-->
<module name="Checker">
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <!-- Analyse main sources only; tests are covered by the compiler and review. -->
  <module name="BeforeExecutionExclusionFileFilter">
    <property name="fileNamePattern" value=".*[\\/]src[\\/]test[\\/].*$"/>
  </module>

  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <module name="NewlineAtEndOfFile"/>

  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="ignorePattern" value="^package.*|^import.*|href|http://|https://|@see"/>
  </module>

  <module name="TreeWalker">
    <!-- Naming: consistency that reviewers should never have to comment on. -->
    <module name="PackageName"/>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="ConstantName"/>

    <!-- Imports: unused imports are dead weight; star imports hide conflicts. -->
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="AvoidStarImport"/>

    <!-- Braces: the dangling-else and accidental-single-statement defect class. -->
    <module name="NeedBraces"/>
    <module name="LeftCurly"/>
    <module name="RightCurly"/>
    <module name="EmptyBlock">
      <property name="option" value="TEXT"/>
    </module>

    <!-- Correctness. -->
    <module name="EqualsHashCode"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="StringLiteralEquality"/>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="IllegalThrows"/>
    <module name="DefaultComesLast"/>
    <module name="OneTopLevelClass"/>
    <module name="CovariantEquals"/>
    <module name="EqualsAvoidNull"/>
    <module name="NoFinalizer"/>
  </module>
</module>
