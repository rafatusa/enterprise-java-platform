# Managed by Ansible — do not edit by hand.
# Written mode 0640, owned by appuser, never logged (no_log: true on the task).

DB_URL=jdbc:postgresql://localhost:5432/{{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}

JWT_SECRET={{ jwt_secret }}
JWT_TTL_SECONDS={{ jwt_ttl_seconds | default(3600) }}

# No default operator credential. site.yml asserts these are supplied, so a
# missing secret fails the deploy loudly instead of shipping a known password.
APP_AUTH_USER={{ app_auth_user | default('operator') }}
APP_AUTH_PASSWORD_HASH={{ app_auth_password_hash }}

SERVER_PORT={{ app_port }}
SPRING_PROFILES_ACTIVE=production
APP_VERSION={{ app_version }}
